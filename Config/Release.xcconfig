// Shared defaults. LocalSecrets.xcconfig (gitignored) may override OUTFIT_ENGINE_BASE_URL.
// #168: DEVICE_TOKEN is intentionally absent — never bake auth secrets into the IPA.
OUTFIT_ENGINE_BASE_URL = https:/$()/stylist-backend.example.invalid
// Apple Team ID: intentionally empty. Set DEVELOPMENT_TEAM in the untracked LocalSecrets.xcconfig.
DEVELOPMENT_TEAM =
// Placeholder bundle identifier. LocalSecrets.xcconfig must override it for a release
// build; the Keychain service used by DeviceTokenStore follows the built identifier.
PRODUCT_BUNDLE_IDENTIFIER = com.example.PersonalStylist
#include? "LocalSecrets.xcconfig"
