// GENERATED locally — do not commit real secrets.
// D-46: DEVICE_TOKEN / ENROLLMENT_SECRET must NOT appear here (would bake into Info.plist).
// For Debug Keychain bootstrap, set Xcode scheme Environment Variables instead:
//   DEVICE_TOKEN=…          (existing opaque token)
//   ENROLLMENT_SECRET=…     (issues a fresh token via POST /v1/auth/device)
OUTFIT_ENGINE_BASE_URL = https:/$()/<your-worker-host>
// Optional — only needed to run on a device:
// DEVELOPMENT_TEAM = <YOUR_TEAM_ID>
